# Google Tag Manager / Google Analytics 4
# GTM container id, e.g. GTM-XXXXXXX
GTM_ID=

# GA4 measurement id, e.g. G-XXXXXXXXXX
# Optional if GA4 is configured inside GTM.
GA4_MEASUREMENT_ID=

# Canonical production URL used in Merchant Center feed, sitemap and Product schema
SITE_URL=https://x-estetik.pl

# Bump this value after deploy when you need browsers/CDN to pull fresh CSS/JS/static assets.
STATIC_VERSION=20260528-meta1

# Google Merchant Center feed / Product schema
MERCHANT_BRAND=X-Estetik
MERCHANT_COUNTRY=PL
MERCHANT_CURRENCY=PLN
MERCHANT_LANGUAGE=pl
MERCHANT_AVAILABILITY=in_stock
MERCHANT_CONDITION=new
MERCHANT_IDENTIFIER_EXISTS=no
MERCHANT_GOOGLE_PRODUCT_CATEGORY=Business & Industrial > Medical > Medical Equipment
MERCHANT_SHIPPING_PRICE=0.00 PLN
MERCHANT_SHIPPING_SERVICE=Dostawa kurierska
MERCHANT_MIN_HANDLING_TIME=0
MERCHANT_MAX_HANDLING_TIME=1
MERCHANT_MIN_TRANSIT_TIME=1
MERCHANT_MAX_TRANSIT_TIME=5

# Empty means all products are included in Merchant Center feed.
MERCHANT_EXCLUDED_SLUGS=
